<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BagSpot : The bag Hub</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="stylesheet" href="/public/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="font-[Poppins]">
    <nav class="w-full flex justify-between items-center px-8 py-4 ">
        <!-- Brand Logo -->
        <h3 class="text-2xl font-bold text-gray-800">BagSpot</h3>
    
        <!-- Navigation Links -->
        <% var loggedIn = typeof loggedIn !== "undefined" ? loggedIn : true %>
        <% if (loggedIn) { %>
            <div class="flex gap-8 text-lg font-medium">
                <a href="/shop" class="text-gray-700 hover:text-indigo-600 transition">Shop</a>
                <a href="/cart" class="text-gray-700 hover:text-indigo-600 transition">Cart</a>
                <a href="/profile" class="text-gray-700 hover:text-indigo-600 transition">My Account</a>
                <a href="/users/Logout" class="text-red-500 hover:text-red-700 transition">Logout</a>
            </div>
        <% } %>
    </nav>
    