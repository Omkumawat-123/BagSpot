<%- include('./partials/header') %>

<div class="w-full min-h-screen bg-gray-100 py-10 px-4 md:px-10">
    <h1 class="text-3xl font-semibold mb-6">Shopping Cart</h1>

    <% if (typeof user !== "undefined" && user.cart && user.cart.length > 0) { %>
        <div class="flex flex-col md:flex-row gap-6">
            <!-- Left Section: Cart Items -->
            <div class="w-full md:w-2/3 bg-white shadow-lg rounded-lg p-6">
                <% user.cart.forEach((item) => { %>
                    <div class="flex items-center gap-4 border-b pb-4 mb-4">
                        <!-- Product Image -->
                        <div class="w-24 h-24 bg-gray-200 rounded-lg overflow-hidden">
                            <img src="data:image/png;base64,<%= item.image.toString('base64') %>" 
                                 alt="Product Image" class="w-full h-full object-cover">
                        </div>

                        <!-- Product Details -->
                        <div class="flex-1">
                            <h3 class="text-lg font-semibold"><%= item.name %></h3>
                            <p class="text-gray-600">₹ <%= item.price %></p>
                            <div class="flex items-center mt-2 gap-3">
                            </div>
                        </div>

                      <!-- Remove Button -->
                      <a href="/cart/remove/<%= item._id %>" class="delete-item text-red-500 hover:text-red-700">
                          <i class="ri-delete-bin-line text-xl"></i>
                      </a>

                    </div>
                <% }) %>
            </div>

            <!-- Right Section: Price Breakdown -->
            <div class="w-full md:w-1/3 bg-white shadow-lg rounded-lg p-6">
                <h2 class="text-2xl font-semibold mb-4">Price Details</h2>
                <div class="space-y-3 text-lg">
                    <div class="flex justify-between">
                        <span>Total MRP</span>
                        <span>₹ <%= user.cart.reduce((sum, item) => sum + Number(item.price), 0) %></span>
                    </div>
                    <div class="flex justify-between">
                        <span>Discount</span>
                        <span class="text-green-600">₹ <%= user.cart.reduce((sum, item) => sum + Number(item.discount), 0) %></span>
                    </div>
                    <div class="flex justify-between">
                        <span>Delivery Charges</span>
                        <span class="text-green-600">FREE</span>
                    </div>
                </div>
                <hr class="my-4 border-gray-300">
                <div class="flex justify-between text-xl font-semibold">
                    <span>Total Amount</span>
                    <span class="text-green-600">₹ <%= user.cart.reduce((sum, item) => sum + (Number(item.price) - Number(item.discount)), 0) %></span>
                </div>
                <button class="w-full mt-6 bg-yellow-500 text-black py-3 rounded-lg text-lg font-semibold hover:bg-yellow-600">
                    Proceed to Buy
                </button>
            </div>
        </div>
    <% } else { %>
        <!-- Empty Cart Message -->
        <div class="flex flex-col items-center justify-center h-60 bg-white shadow-lg rounded-lg p-10 text-center">
            <h2 class="text-2xl font-semibold">Your cart is empty</h2>
            <p class="text-gray-500 mt-2">Add items to your cart to shop now.</p>
        </div>
    <% } %>
</div>

<%- include('./partials/footer') %>